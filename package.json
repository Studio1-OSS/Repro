    "ext:typecheck": "pnpm --filter repro-extension typecheck",
    "ext:release": "tsx scripts/ext-release.mts",
    "bench:app": "node bench/app/server.mjs",
    "bench:real": "tsx bench/real.mts",
    "sandbox:setup": "tsx scripts/sandbox-setup.mts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@libsql/client": "^0.18.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@rrweb/replay": "2.1.7",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^0.508.0",
    "motion": "^14.2.0",
    "nanoid": "^5.1.5",
    "next": "16.2.11",
    "openai": "^7.32.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/chrome": "^0.3.6",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^16.5.0",
    "drizzle-kit": "^0.31.11",
    "playwright-core": "1.56.1",
    "tailwindcss": "^4",
    "tsx": "4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
